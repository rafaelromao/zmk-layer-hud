# runtime
run/
build/
__pycache__/
*.pyc
.DS_Store

# local dumps of the keymap message (python3 host/keymap.py --dump > hud/keymap.json for browser tests)
hud/keymap.json
hud/keymap.js

# the demo script docs/make-gif.sh serves beside the pages (the sources live in docs/)
hud/demo.json
hud/timeline.json

# editor/agent local config
.claude/
# a tool's session file left at the root (`:memory:.ses`: a timestamp and a UUID)
*.ses

# local secrets and logs, should any ever be put beside the tree
.env
.env.*
*.log

# python virtualenv (make venv)
.venv/

hud/keymap-*.json

# the Android keyboard (apps/android): Gradle's and Kotlin's own state, and where the SDK is on this machine
apps/android/.gradle/
apps/android/.kotlin/
apps/android/local.properties

# the iPad keyboard (apps/ios): what is yours to sign it with, a keymap built in, and what xcodegen and
# swift test make
apps/ios/Local.xcconfig
apps/ios/Keyboard/keymap.json
apps/ios/ZmkHud.xcodeproj/
apps/ios/Core/.build/
apps/ios/Core/.swiftpm/
